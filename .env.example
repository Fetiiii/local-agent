# ── LLM Provider ─────────────────────────────────────────────────
# "ollama" (default) or "openai" (any OpenAI-compatible server:
# llama.cpp's llama-server, LM Studio, vLLM, or the real OpenAI API).
LLM_PROVIDER=ollama

# Default model to load on startup. For Ollama this is the model tag
# (e.g. llama3:latest). Leave empty to auto-select the first local model.
MODEL_NAME=

# Base URL for the OpenAI-compatible endpoint (only used when LLM_PROVIDER=openai).
# llama.cpp default: http://localhost:8080/v1
OPENAI_BASE_URL=http://localhost:8080/v1
# API key for the OpenAI-compatible endpoint (llama-server ignores it).
OPENAI_API_KEY=

# Model context window and default sampling temperature.
NUM_CTX=16384
TEMPERATURE=0.7

# ── One-click launcher (start.sh) — llama.cpp auto-start ──────────
# When LLM_PROVIDER=openai and the endpoint at OPENAI_BASE_URL isn't already up,
# ./start.sh launches llama-server for you. Optional overrides:
#   LLAMA_SERVER_BIN  — path to the llama-server binary (else auto-detected on
#                       PATH or ~/llama.cpp/build/bin/llama-server)
#   LLAMA_SERVER_ARGS — extra flags. Default: none → llama.cpp autofits GPU
#                       layers to available VRAM. Set to control offload manually.
# LLAMA_SERVER_BIN=
# LLAMA_SERVER_ARGS=-ngl 99 --flash-attn on

# ── Vision (image_analysis) ──────────────────────────────────────
# Vision can use a different backend than the main model. Empty values
# fall back to the main LLM_PROVIDER / OPENAI_BASE_URL.
#   - llama.cpp: launch llama-server with --mmproj <projector>.gguf and leave
#     these empty (same server serves text + vision via the OpenAI API).
#   - Ollama: set VISION_PROVIDER=ollama and pull a vision model (e.g. qwen2.5vl).
VISION_PROVIDER=
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=qwen3-vl:2b

# Conversations are auto-saved as JSON under data/conversations/ (no DB needed).

# ── Web search (Brave Search API) ────────────────────────────────
# Get a key at https://brave.com/search/api/
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT=10

# ── Agent behaviour ──────────────────────────────────────────────
RETRY_COUNT=3
MAX_STEPS=5

# Ingestion: enable OCR for scanned PDFs (slow, off by default).
INGEST_OCR=false

# Verbose hot-path logging (raw LLM output, tool args). Off by default.
DEBUG=false

# ── Sandbox (isolate shell/code execution) ───────────────────────
# "auto" = use Docker if available, else run on host (NOT isolated).
# "docker" = require Docker (refuse to run on host). "local" = host only.
# Build the image once:
#   docker build -t localagent-sandbox:latest -f docker/sandbox.Dockerfile .
SANDBOX_BACKEND=auto
# Allow container network (needed for pip/npm/git installs; enables exfiltration).
SANDBOX_ALLOW_NETWORK=false
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# SANDBOX_PIDS_LIMIT=256

# Let shell_executor run on the HOST (full machine access, e.g. moving files
# anywhere). Every host command requires in-UI approval. data_analyst stays
# sandboxed regardless. Leave false unless you want host-level tasks.
SHELL_HOST=false
